<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Store the newly created policy</description>
        <name>Populate_Policy</name>
        <label>Populate Policy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPolicyRecord</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Policy</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Create a policy based on the inputted details</description>
    <environments>Default</environments>
    <formulas>
        <description>Today + 1 year</description>
        <name>TodayPlusYear</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 365</expression>
    </formulas>
    <interviewLabel>Create a Policy {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create a Policy</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Create a policy records based on the given inputs</description>
        <name>Create_Policy</name>
        <label>Create Policy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Policy</targetReference>
        </connector>
        <inputAssignments>
            <field>Customer__c</field>
            <value>
                <elementReference>varCustomerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EffectiveDate__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ExpiryDate__c</field>
            <value>
                <elementReference>TodayPlusYear</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PlanType__c</field>
            <value>
                <elementReference>varPlanType</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PolicyMaster__c</field>
            <value>
                <elementReference>varPolicyMasterId</elementReference>
            </value>
        </inputAssignments>
        <object>Policy__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Get the newly created policy</description>
        <name>Get_Policy</name>
        <label>Get Policy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Populate_Policy</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Create_Policy.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Policy__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Policy</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>Customer record&apos;s 18 digit salesforce id</description>
        <name>varCustomerId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Policy Plan Type. It can one of these values - Basic, Standard, Platinum</description>
        <name>varPlanType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Policy Master Record 18 digit salesforce id</description>
        <name>varPolicyMasterId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Newly created policy record</description>
        <name>varPolicyRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Policy__c</objectType>
    </variables>
</Flow>
